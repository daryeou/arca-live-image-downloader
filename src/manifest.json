{
  "manifest_version": 3,
  "name": "Arca Downloader - X 트위터 이미지 및 동영상 다운로드",
  "version": "2.3.1",
  "description": "아카라이브와 X(Twitter)에서 이미지, GIF, 비디오를 확인하고 다운로드하는 확장 프로그램",
  "permissions": [
    "downloads",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*.namu.la/*",
    "https://arca.live/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://api.twitter.com/*",
    "https://abs.twimg.com/*",
    "https://gist.githubusercontent.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://arca.live/*",
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "shared/media-utils.js",
        "content/content.js",
        "content/twitter-resolver.js",
        "content/content-ui.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}